# syntax=docker/dockerfile:1.7
FROM golang:1.26-bookworm AS build
WORKDIR /src
ENV GOMAXPROCS=1 GOFLAGS="-p=1" GOTOOLCHAIN=local
COPY go.mod ./
COPY . .
# Parse all Go sources before the expensive compile on small servers.
RUN find ./cmd ./internal -type f -name '*.go' -print0 | xargs -0 gofmt -e -l >/dev/null
# Cache both module downloads and compiled packages across failed Docker builds.
RUN --mount=type=cache,target=/go/pkg/mod go mod tidy
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/controlplane ./cmd/controlplane \
 && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/controlplane /controlplane
COPY --from=build /out/migrate /migrate
COPY migrations /migrations
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/controlplane"]
