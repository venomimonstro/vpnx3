FROM golang:1.26-bookworm AS build
WORKDIR /src
ENV GOMAXPROCS=1 GOFLAGS="-p=1"
COPY go.mod ./
COPY . .
# Repository currently has no go.sum; resolve and verify module checksums
# within the builder instead of failing with missing go.sum entries.
RUN go mod tidy
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/controlplane ./cmd/controlplane \
 && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/controlplane /controlplane
COPY --from=build /out/migrate /migrate
COPY migrations /migrations
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/controlplane"]
