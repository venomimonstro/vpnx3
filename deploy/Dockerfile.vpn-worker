FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY go.mod ./
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/vpn-worker ./cmd/vpn-worker

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/vpn-worker /vpn-worker
USER nonroot:nonroot
EXPOSE 9090
ENTRYPOINT ["/vpn-worker"]
