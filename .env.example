VPNX3_ENV=development
VPNX3_HTTP_ADDR=:8080
VPNX3_DATABASE_URL=postgres://vpnx3:change_me@127.0.0.1:5432/vpnx3?sslmode=disable
# Optional read-only physical standby endpoint used only for HA/readiness monitoring.
VPNX3_DATABASE_REPLICA_URL=
# In production true makes missing/unavailable standby a startup/readiness blocker.
VPNX3_DATABASE_HA_REQUIRED=false
VPNX3_DATABASE_MAX_CONNS=20
VPNX3_DATABASE_MIN_CONNS=2
VPNX3_DATABASE_CONN_LIFETIME=30m
VPNX3_DATABASE_CONN_JITTER=5m
VPNX3_DATABASE_CONN_IDLE_TIME=5m
VPNX3_DATABASE_STATEMENT_TIMEOUT=8s
VPNX3_DATABASE_LOCK_TIMEOUT=3s
VPNX3_DATABASE_IDLE_TX_TIMEOUT=15s
VPNX3_LOG_LEVEL=info
VPNX3_HTTP_READ_TIMEOUT=10s
VPNX3_HTTP_WRITE_TIMEOUT=15s
VPNX3_HTTP_IDLE_TIMEOUT=60s
VPNX3_DRAIN_DELAY=5s
VPNX3_SHUTDOWN_TIMEOUT=20s
VPNX3_HTTP_MAX_INFLIGHT=512
VPNX3_HTTP_MAX_HEADER_KB=32
VPNX3_ADMIN_SESSION_TTL=12h
# off | user-agent | network. Production forbids off.
VPNX3_ADMIN_SESSION_BINDING=user-agent

# Требуются только при первом запуске пустой БД.
# После создания владельца пароль следует удалить из окружения.
VPNX3_BOOTSTRAP_OWNER_EMAIL=owner@example.com
VPNX3_BOOTSTRAP_OWNER_PASSWORD=replace_with_a_long_random_password

# Сгенерировать командой: go run ./cmd/keygen
VPNX3_CONFIG_SIGNING_KEY=replace_with_32_byte_ed25519_seed_base64url

VPNX3_ACCESS_SIGNING_KEY=replace_with_32_byte_ed25519_seed_base64url
VPNX3_ACCESS_LEASE_TTL=6h
VPNX3_TRIAL_DAYS=7

# Подписанная клиентская сетевая политика
# Пустое значение означает: не переопределять DNS в WireGuard-конфигурации.
VPNX3_CLIENT_DNS=
VPNX3_WG_CLIENT_MTU=1280
VPNX3_WG_KEEPALIVE=25
VPNX3_WG_GATEWAY_IPV4=10.66.0.1

# ЮKassa включается только если заданы все три значения.
VPNX3_YOOKASSA_SHOP_ID=
VPNX3_YOOKASSA_SECRET_KEY=
VPNX3_YOOKASSA_RETURN_URL=

# Artifact storage: local or s3.
VPNX3_ARTIFACT_STORAGE=local

# Local durable storage on Control Plane volume.
VPNX3_ARTIFACT_DIR=/var/lib/vpnx3/artifacts

# S3-compatible storage. Required only when VPNX3_ARTIFACT_STORAGE=s3.
VPNX3_S3_ENDPOINT=
VPNX3_S3_REGION=
VPNX3_S3_BUCKET=
VPNX3_S3_ACCESS_KEY=
VPNX3_S3_SECRET_KEY=
VPNX3_S3_TEMP_DIR=/var/lib/vpnx3/s3tmp
VPNX3_ARTIFACT_MAX_MB=300
VPNX3_ARTIFACT_TRANSFER_TIMEOUT=30m

# Отдельный Ed25519 seed для подписания release metadata.
# Если пусто, публичный release channel отключён.
VPNX3_RELEASE_SIGNING_KEY=

# Offline Root of Trust. Приватный root seed НИКОГДА не размещается на сервере.
# На runtime-сервере хранится только публичный root key и подписанный bundle.
VPNX3_TRUST_ROOT_PUBLIC_KEY=
VPNX3_TRUST_BUNDLE_FILE=/etc/vpnx3/trust-bundle.json

VPNX3_ARTIFACT_RETENTION_DAYS=30

# Reverse-proxy CIDR, которым разрешено задавать X-Forwarded-For/X-Real-IP.
# Оставьте пустым, если Control Plane принимает соединения напрямую.
# Пример для локального Caddy/Nginx: 127.0.0.1/32,::1/128
VPNX3_TRUSTED_PROXY_CIDRS=

# Optional explicit HMAC secret for anonymous registration rate buckets.
# If empty, a domain-separated key is derived from VPNX3_ACCESS_SIGNING_KEY.
VPNX3_REGISTRATION_RATE_KEY=


# Marker успешного off-host backup. Control Plane использует mtime файла в launch readiness.
# Файл должен touch-иться только после завершённого и проверяемого backup.
VPNX3_BACKUP_STATUS_FILE=
# Marker успешной проверки зашифрованной off-site копии у независимого storage provider.
VPNX3_BACKUP_OFFSITE_STATUS_FILE=
# Marker frequent verified PostgreSQL WAL off-site replication.
VPNX3_WAL_OFFSITE_STATUS_FILE=


# Независимый внешний журнал безопасности / SIEM / WORM receiver.
# Используется отдельный Ed25519 seed; receiver хранит только публичный ключ.
VPNX3_SECURITY_EXPORT_URL=
VPNX3_SECURITY_EXPORT_SIGNING_KEY=
